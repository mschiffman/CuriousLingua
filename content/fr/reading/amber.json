   },
   {
    "text": "L’ambre !",
    "tr": {
     "en": "Amber!"
    },
    "t": [
     5.13,
     5.81
    ]
   }
  ],
  [
   {
    "text": "Les Grecs de l’Antiquité pensaient que c’était des gouttes de soleil solidifié.",
    "tr": {
     "en": "The ancient Greeks thought it was droplets of solid sunlight."
    },
    "t": [
     6.71,
     11.6
    ],
    "gloss": {
     "Grecs": [
      "/ɡʀɛk/",
      "the Greeks"
     ],
