      "sun"
     ],
     "solidifié": [
      "/sɔlidifje/",
      "solidified",
      "solidifier /sɔlidifje/"
     ]
    }
   },
   {
    "text": "En réalité, l’ambre vient des arbres.",
    "tr": {
     "en": "In fact, it comes from trees."
    },
    "t": [
     11.76,
     14.39
    ]
   }
  ],
  [
   {
    "text": "Les pins et les sapins laissent s’écouler un liquide épais et collant appelé résine lorsque leur écorce est abîmée.",
    "tr": {
     "en": "Pine and fir trees ooze a thick, sticky liquid called resin if their bark is damaged."
    },
    "t": [
     14.86,
     22.28
    ],
    "gloss": {
