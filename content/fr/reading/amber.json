      "durcir /dyʀsiʀ/"
     ]
    }
   },
   {
    "text": "Tout comme un os de dinosaure, la résine peut se fossiliser et se transformer en ambre.",
    "tr": {
     "en": "Just like a dinosaur bone, the resin can fossilize, transforming into amber."
    },
    "t": [
     26.72,
     32.74
    ],
    "gloss": {
     "os": [
      "/ɔs/",
      "bone"
     ],
     "dinosaure": [
      "/dinɔzɔʀ/",
      "dinosaur"
     ],
     "fossiliser": [
      "/fɔsilize/",
      "to fossilize",
      "fossiliser /fosilize/"
     ],
     "ambre": [
      "/ɑ̃bʀ/",
      "amber"
     ]
    }
   }
  ],
  [
   {
    "text": "L’ambre peut être une capsule temporelle du monde préhistorique.",
    "tr": {
     "en": "Amber can be a time capsule to the prehistoric world."
    },
    "t": [
     32.96,
     37.17
    ],
    "gloss": {
     "capsule": [
      "/kapsyl/",
      "capsule"
     ],
     "temporelle": [
      "/tɑ̃pɔʀɛl/",
      "time (adj) / temporal"
     ],
     "préhistorique": [
      "/pʀeistɔʀik/",
      "prehistoric"
     ]
    }
   },
   {
    "text": "Si une araignée ou un insecte marche sur cette substance dorée alors qu’elle est encore collante, il peut rester piégé.",
    "tr": {
     "en": "If a spider or insect walks across the golden goo when it is still sticky, it can get trapped."
    },
    "t": [
     37.37,
     45.52
    ],
    "gloss": {
     "araignée": [
      "/aʀeɲe/",
      "spider"
     ],
     "substance": [
      "/sypstɑ̃s/",
      "substance"
     ],
     "dorée": [
      "/dɔʀe/",
      "golden"
     ],
     "piégé": [
      "/pjeʒe/",
      "trapped",
      "piéger /pjeʒe/"
     ]
    }
   },
   {
    "text": "Lorsque la résine se transforme en ambre, la petite créature est emprisonnée pour toujours, et nous pouvons la voir telle qu’elle était il y a des millions d’années.",
    "tr": {
     "en": "As the resin turns to amber, the creepy-crawly is trapped forever, and we can see it as it was millions of years ago."
    },
    "t": [
     45.79,
     56.12
    ],
    "gloss": {
     "créature": [
      "/kʀeatyʀ/",
      "creature"
     ],
     "emprisonnée": [
      "/ɑ̃pʀizɔne/",
      "imprisoned",
      "emprisonner /ɑ̃pʀizɔne/"
     ]
    }
   }
  ],
  [
   {
    "text": "Un type rare d’ambre est orange jusqu’à ce qu’on le voie à la lumière du soleil… où il devient bleu !",
    "tr": {
     "en": "One rare type of amber is orange until seen in sunlight, when it turns blue!"
    },
    "t": [
     56.95,
     64.1
    ],
    "gloss": {
