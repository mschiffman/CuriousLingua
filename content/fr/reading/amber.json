      "abîmer /abime/"
     ]
    }
   },
   {
    "text": "La résine coule pour boucher les blessures, puis elle durcit.",
    "tr": {
     "en": "The resin drips out to plug any cuts, and then hardens."
    },
    "t": [
     22.49,
     26.49
    ],
    "gloss": {
     "coule": [
      "/kul/",
      "flows",
      "couler /kule/"
     ],
     "boucher": [
      "/buʃe/",
      "to block / fill",
      "boucher /buʃe/"
     ],
