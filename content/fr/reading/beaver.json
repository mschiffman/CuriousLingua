     ]
    },
    "t": [
     14.22,
     26.38
    ]
   }
  ],
  [
   {
    "text": "Le résultat ?",
    "tr": {
     "en": "And the result?"
    },
    "gloss": {
     "résultat": [
      "/ʀezylta/",
      "result"
     ]
    },
    "t": [
     26.38,
     27.95
    ]
   },
   {
    "text": "Des étangs paisibles, tout doux, qui deviennent de véritables refuges pour tout le monde : poissons, grenouilles, oiseaux, insectes… un petit paradis pour la biodiversité.",
    "tr": {
     "en": "Peaceful, gentle ponds that turn into safe havens for everyone — fish, frogs, birds, insects… a little paradise bursting with life."
    },
    "gloss": {
     "étangs": [
      "/etɑ̃/",
      "ponds"
     ],
     "paisibles": [
      "/pezibl/",
      "peaceful"
     ],
