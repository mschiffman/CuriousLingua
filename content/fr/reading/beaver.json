     ]
    },
    "t": [
     41.68,
     53.87
    ]
   },
   {
    "text": "Ils font tout ça avec une patience et une tendresse qui donnent envie de les applaudir.",
    "tr": {
     "en": "And they do it all with such patience and tenderness, you just want to give them a round of applause."
    },
    "gloss": {
     "font": [
      "/fɔ̃/",
      "to make/do",
      "faire /fɛʀ/"
     ],
     "patience": [
      "/pasjɑ̃s/",
      "patience"
     ],
     "tendresse": [
      "/tɑ̃dʀɛs/",
      "tenderness"
     ],
     "donnent": [
      "/dɔn/",
      "to give",
      "donner /dɔne/"
     ],
     "applaudir": [
      "/aplodiʀ/",
      "to applaud"
     ]
    },
    "t": [
     53.94,
     59.47
    ]
   }
  ],
  [
   {
    "text": "Et le plus beau ?",
    "tr": {
     "en": "And the best part?"
    },
    "t": [
     59.62,
     60.57
    ]
   },
   {
    "text": "Même quand le castor s’en va, son œuvre continue d’aider la vie autour de lui.",
    "tr": {
     "en": "Even after the beaver moves on, its work keeps helping life all around it."
    },
    "gloss": {
     "œuvre": [
      "/œvʀ/",
      "work/masterpiece"
     ],
     "autour": [
      "/otuʀ/",
      "around"
     ]
    },
    "t": [
     60.68,
     65.59
    ]
   },
   {
    "text": "Comme un cadeau laissé derrière, silencieux mais précieux.",
    "tr": {
     "en": "Like a gift it quietly leaves behind — silent, but precious."
    },
    "gloss": {
     "derrière": [
      "/dɛʀjɛʀ/",
      "behind"
     ],
     "silencieux": [
      "/silɑ̃sjø/",
      "silent"
     ],
     "précieux": [
      "/pʀesjø/",
      "precious"
     ]
    },
    "t": [
     65.72,
     69.87
    ]
   }
  ],
  [
   {
    "text": "Les castors nous rappellent que travailler avec la nature, ce n’est pas une corvée : c’est une longue histoire d’amour entre toutes les formes de vie.",
    "tr": {
     "en": "Beavers remind us that working with nature isn’t a chore — it’s a long, beautiful love story between all living things."
    },
    "gloss": {
     "rappellent": [
