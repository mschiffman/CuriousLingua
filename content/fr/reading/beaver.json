 "paragraphs": [
  [
   {
    "text": "Les castors, franchement, ce sont de véritables petits génies de la nature.",
    "tr": {
     "en": "Beavers, honestly, are true little geniuses of nature."
    },
    "gloss": {
     "castors": [
      "/kastɔʀ/",
      "beavers"
     ],
     "génies": [
      "/ʒeni/",
      "geniuses"
     ]
    },
    "t": [
     4.64,
     9.97
    ]
   },
   {
    "text": "De vrais bosseurs, adorables et dévoués.",
    "tr": {
     "en": "Hard-working, adorable, and full of devotion."
    },
    "gloss": {
     "bosseurs": [
      "/bɔsœʀ/",
      "hard workers"
     ],
     "dévoués": [
      "/devwe/",
      "devoted"
     ]
    },
    "t": [
     10.5,
     13.75
    ]
   },
   {
    "text": "Avec leurs dents surpuissantes, ils coupent des arbres comme si ce n’était rien du tout et construisent des barrages tellement ingénieux qu’on dirait des architectes en mission secrète.",
    "tr": {
     "en": "With their super-powered teeth, they chop down trees like it’s nothing and build dams so clever you’d think they were secret-agent architects on a mission."
    },
    "gloss": {
     "surpuissantes": [
      "/syʀpɥisɑ̃t/",
      "super powerful"
     ],
     "coupent": [
