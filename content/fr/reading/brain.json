      "memory"
     ]
    },
    "t": [
     38.82,
     42.56
    ]
   }
  ],
  [
   {
    "text": "Et tout ce beau monde communique en permanence, comme un réseau ultra-rapide.",
    "tr": {
     "en": "And this whole team is in constant communication, like a high-speed network."
    },
    "gloss": {
     "communique": [
      "/kɔmynik/",
      "communicates",
      "communiquer /kɔmynike/"
