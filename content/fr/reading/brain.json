      "to reason"
     ],
     "créer": [
      "/kʀee/",
      "to create"
     ]
    },
    "t": [
     31.39,
     35.52
    ]
   },
   {
    "text": "Le cervelet, pour l’équilibre et les gestes fluides.",
    "tr": {
     "en": "The cerebellum, for balance and smooth movements."
    },
    "gloss": {
     "cervelet": [
      "/sɛʀvəlɛ/",
      "cerebellum"
     ],
     "équilibre": [
      "/ekilibʀ/",
      "balance"
     ]
    },
    "t": [
     35.6,
     38.74
    ]
   },
   {
    "text": "Le système limbique, pour les émotions et la mémoire.",
    "tr": {
     "en": "The limbic system, for emotions and memory."
    },
    "gloss": {
     "système": [
      "/sistɛm/",
      "system"
     ],
