  [
   {
    "text": "Le cerveau fonctionne grâce à toute une équipe :",
    "tr": {
     "en": "The brain works thanks to an entire team:"
    },
    "t": [
     28.3,
     31.39
    ]
   },
   {
    "text": "Le cortex cérébral, pour penser, raisonner, créer, comprendre.",
    "tr": {
     "en": "The cerebral cortex, for thinking, reasoning, creating and understanding."
    },
    "gloss": {
     "cortex": [
      "/kɔʀtɛks/",
      "cortex"
     ],
     "cérébral": [
      "/seʀebʀal/",
