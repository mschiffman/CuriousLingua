  {
   "title": "Le pain",
   "lines": [
    {
     "who": "C",
     "text": "Bonjour, je peux avoir une baguette ?",
     "tr": {
      "en": "Hello, can I have a baguette?"
     }
    },
    {
     "who": "V",
     "text": "Bien sûr.",
     "tr": {
      "en": "Of course."
     }
    },
    {
     "who": "C",
     "text": "Elle est du jour ?",
     "tr": {
      "en": "Is it today's?"
     }
    },
    {
     "who": "V",
     "text": "Oui, elle est toute fraîche.",
     "tr": {
      "en": "Yes, it's completely fresh."
     }
    },
    {
     "who": "C",
     "text": "Parfait, merci.",
     "tr": {
      "en": "Perfect, thank you."
     }
    }
   ]
  },
  {
   "title": "Le fromage",
   "lines": [
    {
     "who": "C",
     "text": "Bonjour. Vous me conseillez quel fromage ?",
     "tr": {
      "en": "Hello. Which cheese do you recommend?"
     }
    },
    {
     "who": "V",
     "text": "Celui-ci est très bon.",
     "tr": {
      "en": "This one is very good."
     }
    },
    {
     "who": "C",
     "text": "Il est fort ?",
     "tr": {
      "en": "Is it strong?"
     }
    },
    {
     "who": "V",
     "text": "Non, il est assez doux.",
     "tr": {
      "en": "No, it's fairly mild."
     }
    },
    {
     "who": "C",
     "text": "D’accord, j’en prends un morceau.",
     "tr": {
      "en": "All right, I'll take a piece."
     }
